PORT=3000
# Публичный адрес сайта (для возврата после оплаты Stripe)
BASE_URL=http://localhost:3000
# Валюта (код ISO для Stripe) и символ для витрины
CURRENCY=rub
# Ключи Stripe (https://dashboard.stripe.com/test/apikeys). Без ключа работает ДЕМО-оплата.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Администратор, создаётся при первом запуске
ADMIN_EMAIL=admin@shop.local
ADMIN_PASSWORD=admin12345
SHOP_NAME=МОЙ МАГАЗИН
